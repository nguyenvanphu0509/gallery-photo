# Defaults work with the local Docker Compose setup. Local learning only.
PORT=3001
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=moments
S3_ACCESS_KEY=gallery-local
S3_SECRET_KEY=gallery-local-secret
DATABASE_PATH=.data/gallery.sqlite
# Set true when serving through HTTPS. Keep false for local HTTP.
COOKIE_SECURE=false
